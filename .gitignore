# ── 运行时数据，绝不入库 ──────────────────────────────────────────
# data/lingops.db 里有真实资产 IP、WebShell 凭据、admin 密码哈希
data/*
!data/.gitkeep
# 内容库种子是随包发布的资产，必须入库（lingops.db 仍然禁止）
!data/poc/
data/poc/*
!data/poc/*.json

# ARTEX 运行时状态：MITM CA 私钥、流量抓包、JWT 密钥、数据库口令
artex/data/
artex/jwt.key
artex/config.json

# ── CVE 采集缓存（NVD 原始响应，几十 MB，不入库）────────────────
.cache/

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/

# ── 编辑器 / 系统 ────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

# ── 构建产物 ─────────────────────────────────────────────────────
*.zip
dist/
# 但注入层是源码，必须入库（其余 dist/ 是官方构建产物，不入库）
!/frontend/dist/
frontend/dist/*
!/frontend/dist/assets_v2/
frontend/dist/assets_v2/*
!/frontend/dist/assets_v2/lp-ext/
!/frontend/dist/assets_v2/lp-ext/**
